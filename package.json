{
  "name": "personal-infobox",
  "version": "0.2.0-beta.1",
  "description": "A local-first Windows knowledge inbox and workbench.",
  "author": "Julien050610",
  "private": true,
  "type": "module",
  "main": "desktop/main.js",
  "scripts": {
    "build:editor": "node scripts/build-editor.mjs",
    "prestart": "npm run build:editor",
    "start": "node src/server.js",
    "preworkbench": "npm run build:editor",
    "workbench": "node src/server.js",
    "run:once": "node src/run-once.js",
    "pretest": "npm run build:editor",
    "test": "node --test",
    "desktop": "npm run build:editor && electron .",
    "package:win": "npm run build:editor && electron-builder --win portable --x64"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@lezer/markdown": "^1.8.0",
    "cheerio": "^1.2.0",
    "codemirror": "^6.0.2",
    "katex": "^0.19.0",
    "music-metadata": "^11.16.0",
    "pdfjs-dist": "^6.3.289",
    "undici": "^7.30.0",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.infobox.desktop",
    "productName": "InfoBox",
    "artifactName": "InfoBox-${version}-windows-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "web/**/*",
      "package.json",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
