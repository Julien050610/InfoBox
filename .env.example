AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-flash
# Used for images when DEEPSEEK_MODEL is text-only, such as deepseek-v4-pro.
DEEPSEEK_VISION_MODEL=deepseek-flash
# Optional alternative generation provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional decision layer. Without this key, the analysis model decides categories and tags.
JEV_API_KEY=
PORT=3000
DATA_DIR=.
